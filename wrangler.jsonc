{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hardscape-configurator",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Vite writes the static build here; wrangler uploads it as-is.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
